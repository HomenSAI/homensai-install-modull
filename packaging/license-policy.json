{
  "schema_version": 1,
  "policy_id": "homensai-commercial-and-noncommercial-distribution-v1",
  "purpose": "Conservative project release policy; candidate licenses do not grant approval to an artifact or replace legal review.",
  "production_fail_closed": true,
  "allowed_review_state": "APPROVED",
  "blocked_review_states": ["UNKNOWN", "PENDING_REVIEW", "UNAPPROVED", "CONFLICT", "DENIED"],
  "required_release_reviews": ["complete_artifact_scope", "transitive_closure", "source_provenance", "security_baseline", "product_licensing"],
  "license_rules": {
    "MIT": {"runtime": "candidate", "build": "candidate", "obligations": ["retain_license_notice"]},
    "MIT-0": {"runtime": "candidate", "build": "candidate", "obligations": []},
    "0BSD": {"runtime": "candidate", "build": "candidate", "obligations": []},
    "BSD-2-Clause": {"runtime": "candidate", "build": "candidate", "obligations": ["retain_license_notice"]},
    "BSD-3-Clause": {"runtime": "candidate", "build": "candidate", "obligations": ["retain_license_notice", "no_endorsement"]},
    "Apache-2.0": {"runtime": "candidate", "build": "candidate", "obligations": ["retain_license_notice", "preserve_notice_if_supplied", "record_modifications"]},
    "Apache-2.0 WITH LLVM-exception": {"runtime": "review", "build": "candidate", "obligations": ["retain_license_notice", "verify_exception_scope"]},
    "ISC": {"runtime": "candidate", "build": "candidate", "obligations": ["retain_license_notice"]},
    "Zlib": {"runtime": "candidate", "build": "candidate", "obligations": ["retain_applicable_notice", "record_modifications"]},
    "X11": {"runtime": "candidate", "build": "candidate", "obligations": ["retain_license_notice", "no_endorsement"]},
    "TCL": {"runtime": "candidate", "build": "candidate", "obligations": ["retain_license_notice", "record_modifications"]},
    "bzip2-1.0.6": {"runtime": "candidate", "build": "candidate", "obligations": ["retain_license_notice", "record_modifications"]},
    "PSF-2.0": {"runtime": "candidate", "build": "candidate", "obligations": ["retain_license_notice", "record_modifications"]},
    "Python-2.0": {"runtime": "candidate", "build": "candidate", "obligations": ["retain_license_notice", "record_modifications"]},
    "CNRI-Python": {"runtime": "review", "build": "candidate", "obligations": ["retain_license_notice", "record_modifications"]},
    "Unicode-3.0": {"runtime": "candidate", "build": "candidate", "obligations": ["retain_license_notice"]},
    "LicenseRef-SQLite-Public-Domain": {"runtime": "review", "build": "candidate", "obligations": ["verify_public_domain_provenance"]},
    "MPL-2.0": {"runtime": "review", "build": "candidate", "obligations": ["retain_license_notice", "file_source_availability", "record_modifications"]},
    "LGPL-2.1-or-later": {"runtime": "review", "build": "candidate", "obligations": ["retain_license_notice", "source_availability", "relinking_and_reverse_engineering_rights"]},
    "GPL-2.0-only": {"runtime": "review", "build": "candidate", "obligations": ["retain_license_notice", "source_availability", "copyleft_distribution_compatibility"]},
    "GPL-2.0-or-later": {"runtime": "review", "build": "candidate", "obligations": ["retain_license_notice", "source_availability", "copyleft_distribution_compatibility"]},
    "GPL-3.0-only": {"runtime": "review", "build": "candidate", "obligations": ["retain_license_notice", "source_availability", "copyleft_distribution_compatibility"]},
    "GPL-3.0-or-later": {"runtime": "review", "build": "candidate", "obligations": ["retain_license_notice", "source_availability", "copyleft_distribution_compatibility"]},
    "GPL-2.0-or-later WITH Bootloader-exception": {"runtime": "review", "build": "candidate", "obligations": ["verify_exception_scope"]},
    "GPL-3.0-or-later WITH GCC-exception-3.1": {"runtime": "review", "build": "candidate", "obligations": ["verify_exception_scope", "runtime_redistribution_source_compliance"]},
    "Sleepycat": {"runtime": "review", "build": "candidate", "obligations": ["retain_license_notice", "source_availability", "accompanying_software_source_compatibility"]},
    "CC-BY-NC-4.0": {"runtime": "deny", "build": "deny", "obligations": [], "reason": "Noncommercial restriction conflicts with the requested commercial use."},
    "CC-BY-NC-SA-4.0": {"runtime": "deny", "build": "deny", "obligations": [], "reason": "Noncommercial restriction conflicts with the requested commercial use."},
    "CC-BY-NC-ND-4.0": {"runtime": "deny", "build": "deny", "obligations": [], "reason": "Noncommercial restriction conflicts with the requested commercial use."},
    "LicenseRef-No-Redistribution": {"runtime": "deny", "build": "review", "obligations": [], "reason": "No redistribution grant."}
  },
  "notes": [
    "GPL, LGPL, MPL and Sleepycat are not automatically bans on commercial activity. Their obligations and the actual linking/distribution model need a recorded review.",
    "WITH exceptions attach to the immediately preceding license; they are never discarded during matching.",
    "An OR choice must be explicitly selected and recorded. AND requires every selected license and obligation.",
    "A build-only component must have no redistributed artifact paths. Compiler runtimes, bootloaders and runtime hooks embedded in outputs are separate redistributed components.",
    "A license_ref, SPDX identifier, SBOM, package metadata field, checksum or signature alone is not a release approval.",
    "Unknown license atoms and custom LicenseRef expressions fail closed until this versioned policy and the exact component review are updated."
  ]
}
