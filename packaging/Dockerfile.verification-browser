# Сначала собрать packaging/Dockerfile.verification с этим локальным DEV tag.
FROM hinstall-dev:verification
RUN apt-get update && apt-get install -y --no-install-recommends chromium npm \
    && rm -rf /var/lib/apt/lists/*
RUN npm --prefix /opt/browser install playwright@1.58.2 --ignore-scripts
ENV HINSTALL_TEST_BROWSER=/usr/bin/chromium NODE_PATH=/opt/browser/node_modules
