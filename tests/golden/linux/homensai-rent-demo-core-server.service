[Unit]
Description=homensai-rent-demo-core-server
After=
Requires=
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
ExecStart="python" "-m" "fictitious_rent_demo.core_server"
WorkingDirectory="/srv/demo/demo-layout/app"
Restart=on-failure
RestartSec=60
Environment=HOMENSAI_WEB_HOST=127.0.0.1
Environment=HOMENSAI_WEB_PORT=8820

[Install]
WantedBy=multi-user.target
